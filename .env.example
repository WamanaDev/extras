# Ver specs/00-fundacao/ambiente.md para a descrição de cada variável.
# NUNCA commitar um .env real. Segredos de produção vivem no gerenciador de
# segredos da Vercel.

# --- Server ---

# Pooler em modo transaction. Obrigatório ?pgbouncer=true&connection_limit=1
# (D-02: pooler transacional não sustenta pg_advisory_lock de sessão).
DATABASE_URL="postgresql://postgres:postgres@localhost:6543/extras?pgbouncer=true&connection_limit=1"

# Conexão direta, porta 5432. Usada só por `prisma migrate`.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/extras"

# Nunca exposta ao cliente.
SUPABASE_SERVICE_ROLE_KEY="troque-me"

# Assinatura do cookie de sessão. >= 32 bytes. Rotacionar invalida todas as sessões.
SESSION_SECRET="troque-me-com-pelo-menos-32-bytes-aleatorios"

# Peppers dos hashes de CPF e PIN. Rotação exige rehash em massa.
CPF_PEPPER="troque-me"
PIN_PEPPER="troque-me"

# Rate limit (Upstash Redis).
UPSTASH_REDIS_REST_URL="https://troque-me.upstash.io"
UPSTASH_REDIS_REST_TOKEN="troque-me"

# Fuso horário obrigatório do runtime e do banco. Só precisa disto em dev
# local (`.env.local`) — `TZ` é nome reservado na Vercel (não configurável
# via dashboard/vercel.json); em produção lá, `src/env.ts` seta isso sozinho
# no boot, nada a fazer.
TZ="America/Sao_Paulo"

# Opcional — usada só por `prisma/seed.ts` (DB-005, specs/03-banco/migrations.md,
# seção "Seed") para convidar o admin inicial via Supabase Auth Admin API.
# Sem ela, o seed pula esse passo com aviso, em vez de falhar.
ADMIN_INICIAL_EMAIL="admin@troque-me.exemplo"

# Opcional — usada só por `prisma/seed.ts` pra montar o `redirectTo` do
# convite do admin inicial (`/admin/definir-senha`). Sem ela, o convite cai
# no "Site URL" padrão configurado no projeto Supabase.
NEXT_PUBLIC_APP_URL="https://troque-me.exemplo"

# Web Push (opcional — preparação de infra, nenhum gatilho de negócio dispara
# push ainda). Gerar o par de chaves de verdade com
# `npx web-push generate-vapid-keys` (ou `webpush.generateVAPIDKeys()`) antes
# de habilitar push em produção. Nunca commitar a chave privada real aqui.
VAPID_PRIVATE_KEY="troque-me"
VAPID_SUBJECT="mailto:contato@troque-me.exemplo"

# Autentica /api/cron/* (lembrete de extra) — Vercel envia
# `Authorization: Bearer <CRON_SECRET>` sozinho quando esta variável está
# configurada no projeto. Gerar com `openssl rand -hex 32`. Sem ela, a rota
# de cron recusa tudo (não é erro de boot).
CRON_SECRET="troque-me"

# Google Calendar (OAuth, opcional) — botão do colaborador pra sincronizar a
# escala/extras na agenda pessoal. Client ID/Secret vêm do Google Cloud
# Console (Credenciais → ID do cliente OAuth, tipo "Aplicativo da Web").
# CALENDAR_TOKEN_KEY cifra o refresh token antes de gravar no banco — gerar
# com `openssl rand -hex 32`. Sem as três, a integração fica desabilitada.
GOOGLE_CLIENT_ID="troque-me.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="troque-me"
CALENDAR_TOKEN_KEY="troque-me-64-caracteres-hexadecimais"

# --- Client (NEXT_PUBLIC_*, vão para o bundle do browser) ---

NEXT_PUBLIC_SUPABASE_URL="https://troque-me.supabase.co"

# Só Realtime de leitura em `plantao` (RLS restringe o resto).
NEXT_PUBLIC_SUPABASE_ANON_KEY="troque-me"

# Par público da VAPID key acima (opcional, mesmo motivo).
NEXT_PUBLIC_VAPID_PUBLIC_KEY="troque-me"
